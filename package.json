{
  "name": "personabridge",
  "private": true,
  "version": "0.1.0",
  "description": "Personal AI partner with chat, voice room planning, memory boundaries, and approval-gated actions.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check-workspace.mjs",
    "dev:web": "npm run dev -w @personabridge/web",
    "dev:api": "python -m uvicorn services.api.app.main:app --reload --port 8200"
  },
  "engines": {
    "node": ">=20.9",
    "python": ">=3.10"
  }
}
